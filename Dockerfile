FROM python:3.12-slim
ARG APP_VERSION=dev
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    HOST=0.0.0.0 PORT=8080 DB_PATH=/data/tasks.db APP_VERSION=${APP_VERSION}
WORKDIR /app
RUN mkdir /data && chown 10001:10001 /data
COPY app.py /app/app.py
USER 10001:10001
EXPOSE 8080
CMD ["python", "app.py"]
